# Copy to .env.local for local development, and add the same two variables
# in Vercel → Project → Settings → Environment Variables.
#
# Both values are safe to expose in the browser. The anon key is protected by
# Postgres Row Level Security — never put the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
